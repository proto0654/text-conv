#!/usr/bin/env -S python3 -S
"""Правка выделенного текста в Hyprland/Wayland.

Режимы:
  layout   сменить раскладку выделенного: латиница -> кириллица или наоборот
           (направление определяется по преобладающим буквам)
  case     инвертировать регистр выделенного (Привет -> пРИВЕТ)

  --stdin  не трогать буфер обмена, читать текст из stdin и печатать результат
           (для отладки и тестов)

Как работает без автодетекта: запоминаем текущий буфер, жмём «копировать»
(Ctrl+C, а в терминалах Ctrl+Shift+C) и ждём, пока содержимое буфера изменится —
это и есть выделенный текст. Не изменилось = копирование не прошло: смотрим
PRIMARY-выделение, затем пробуем выделить слово слева от курсора.
Дальше кладём в буфер результат и жмём «вставить», после чего возвращаем
прежнее содержимое буфера обмена.
"""

import os
import subprocess
import sys
import time

# --- таблицы раскладок -------------------------------------------------------

EN = "qwertyuiop[]" + "asdfghjkl;'" + "zxcvbnm,./" + "`"
RU = "йцукенгшщзхъ" + "фывапролджэ" + "ячсмитьбю." + "ё"

# символы, живущие на тех же клавишах с Shift
SHIFT_PAIRS = {
    "~": "Ё", "{": "Х", "}": "Ъ", ":": "Ж", '"': "Э", "<": "Б",
    ">": "Ю", "?": ",", "|": "/", "@": '"', "#": "№", "$": ";",
    "^": ":", "&": "?", "[": "х", "]": "ъ",
}


def _tables():
    en_ru, ru_en = {}, {}
    for e, r in zip(EN, RU):
        en_ru[e] = r
        ru_en[r] = e
        if e.upper() != e:  # только буквы: у пунктуации .upper() не меняет символ
            en_ru[e.upper()] = r.upper()
            ru_en[r.upper()] = e.upper()
    for k, v in SHIFT_PAIRS.items():
        en_ru.setdefault(k, v)
        ru_en.setdefault(v, k)
    return en_ru, ru_en


EN_RU, RU_EN = _tables()

# str.translate — цикл на C: одна таблица на направление, ~2x быстрее
# "".join(dict.get(c, c) for c in text) и без лямбд, как в re.sub
TRANS = {"en->ru": str.maketrans(EN_RU), "ru->en": str.maketrans(RU_EN)}

# Браузеры и Electron-приложения под XWayland: Ctrl+C при физически зажатом
# Shift уходит как Ctrl+Shift+C — Chrome открывает «Inspect element» (DevTools),
# VS Code — внешний терминал. В таких окнах сначала берём PRIMARY-выделение без
# инъекции, а «копировать» жмём только после паузы, за которую Shift успевает
# отпуститься. Пауза платится лишь в браузерах, остальные окна не тормозятся.
BROWSER_HINTS = (
    "chrome", "chromium", "brave", "vivaldi", "opera", "edge",
    "electron", "code", "cursor", "slack", "discord",
)
BROWSER_MOD_DELAY = 0.15

TERMINAL_HINTS = (
    "alacritty", "foot", "kitty", "ghostty", "wezterm",
    "konsole", "xterm", "urxvt", "tilix", "term",
)

LOG = "/tmp/text-conv.log"


def log(msg):
    try:
        if os.path.exists(LOG) and os.path.getsize(LOG) > 200_000:
            os.replace(LOG, LOG + ".1")
        with open(LOG, "a", encoding="utf-8") as f:
            f.write("%s %s\n" % (time.strftime("%H:%M:%S"), msg))
    except OSError:
        pass


DEBUG = bool(os.environ.get("TEXT_CONV_DEBUG"))


def dbg(msg):
    if DEBUG:
        log(msg)


def run(cmd, data=None, timeout=6, quiet=False):
    out = subprocess.DEVNULL if quiet else subprocess.PIPE
    try:
        return subprocess.run(
            cmd, input=data, stdout=out, stderr=out, timeout=timeout
        )
    except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
        log("fail %s: %r" % (cmd, exc))
        return None


def notify(msg):
    run(["notify-send", "-a", "text-conv", "-t", "2500", "Текст", msg])


# --- преобразования ----------------------------------------------------------

def convert_layout(text):
    """Каждый символ меняется на тот, что стоит на этой же клавише в другой
    раскладке (`]` ~ `ъ`, `.` ~ `ю`, `/` ~ `.`, `?` ~ `,`, `"` ~ `Э`).

    Никаких исключений по месту в слове: переключение раскладки — это
    переотображение клавиш, поэтому правило одно и предсказуемое.
    """
    latin = sum(1 for c in text if ("a" <= c.lower() <= "z"))
    cyr = sum(1 for c in text if ("а" <= c.lower() <= "я") or c.lower() in "ёіїє")
    direction = "en->ru" if latin >= cyr else "ru->en"
    return text.translate(TRANS[direction]), direction


def convert_case(text):
    return text.swapcase()


def transform(text, mode):
    if mode == "layout":
        out, direction = convert_layout(text)
        if out == text:
            return None, "нечего менять (%s)" % direction
        return out, direction
    if mode == "case":
        if not text:
            return None, "пусто"
        out = convert_case(text)
        if out == text:
            return None, "регистр менять не нужно"
        return out, "case"
    raise SystemExit("неизвестный режим: %s" % mode)


# --- работа с буфером обмена -------------------------------------------------

def active_window():
    """Классы активного окна одной строкой — без `-j`, чтобы не тянуть json
    на старте (его импорт стоит ~10 мс из ~190 мс нажатия)."""
    r = run(["hyprctl", "activewindow"])
    if not r or r.returncode != 0:
        return ""
    out = []
    for line in (r.stdout or b"").decode("utf-8", "replace").splitlines():
        key, _, val = line.strip().partition(":")
        if key in ("class", "initialClass"):
            out.append(val.strip().lower())
    return " ".join(out)


def read_clip():
    r = run(["wl-paste", "-n"], timeout=5)
    if not r or r.returncode != 0:
        return None
    return r.stdout


def read_primary():
    r = run(["wl-paste", "-p", "-n"], timeout=5)
    if not r or r.returncode != 0:
        return None
    return r.stdout or None


def write_clip(data):
    if not isinstance(data, bytes):
        data = data.encode("utf-8")
    # тихо: wl-copy форкает демона, который держит унаследованные пайпы открытыми
    return run(["wl-copy"], data=data, timeout=6, quiet=True)


def set_clip(data, timeout=1.5):
    """Кладём данные в буфер и ждём, пока wl-copy реально станет владельцем.

    wl-copy форкает демона, который берёт владение асинхронно: если отправить
    Ctrl+C сразу, копирование приложения проиграет гонку и буфер останется
    с нашим содержимым (или наоборот — с чужим).
    """
    want = data if isinstance(data, bytes) else data.encode("utf-8")
    write_clip(want)
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(0.004)  # мельче шаг — раньше ловим владение (wl-copy ~47 мс)
        if read_clip() == want:
            return True
    log("clip not confirmed: %r" % (want[:40],))
    return False


def send_chord(key, terminal=False, shift=False, release_mods=False):
    """Ctrl+<key> через wtype. release_mods — сначала отпустить модификаторы
    хоткея: если Shift ещё зажат, Ctrl+C уйдёт как Ctrl+Shift+C (в Chrome это
    «inspect element»). Отдельный вызов wtype на отпускание стоил ещё 15 мс,
    поэтому всё в одной команде."""
    need_shift = shift or terminal
    args = ["wtype"]
    if release_mods:
        args += ["-m", "shift", "-m", "ctrl", "-m", "alt", "-m", "logo"]
    args += ["-M", "ctrl"]
    if need_shift:
        args += ["-M", "shift"]
    args += ["-k", key]
    if need_shift:
        args += ["-m", "shift"]
    args += ["-m", "ctrl"]
    r = run(args, timeout=6)
    if DEBUG:  # active_window() — это ещё один вызов hyprctl, не дёргаем зря
        dbg(
            "wtype %r rc=%s err=%r focus=%r"
            % (args[1:], getattr(r, "returncode", None), (getattr(r, "stderr", b"") or b"")[:120], active_window())
        )


def select_word_left():
    """Ctrl+Shift+Left — выделить слово слева от курсора."""
    r = run(
        ["wtype", "-M", "ctrl", "-M", "shift", "-k", "Left", "-m", "shift", "-m", "ctrl"],
        timeout=6,
    )
    dbg("select-word-left rc=%s" % getattr(r, "returncode", None))


def switch_keyboard_layout(direction):
    """Переключить системную раскладку на ту, в которую сконвертировали текст."""
    import json  # лениво: вызов идёт уже после вставки, на старте не нужен

    target = "ru" if direction == "en->ru" else "us"
    r = run(["hyprctl", "-j", "devices"])
    if not r or r.returncode != 0:
        return
    try:
        data = json.loads(r.stdout or b"{}")
    except json.JSONDecodeError:
        return
    for kb in data.get("keyboards", []):
        name = kb.get("name")
        items = [x.strip() for x in (kb.get("layout") or "").split(",") if x.strip()]
        if not name or target not in items:
            continue
        idx = items.index(target)
        if kb.get("active_layout_index") == idx:
            dbg("layout %s уже %s" % (name, target))
            continue
        run(["hyprctl", "switchxkblayout", name, str(idx)])
        dbg("layout %s -> %s (%d)" % (name, target, idx))


def main():
    argv = [a for a in sys.argv[1:]]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 1
    mode = argv[0]
    stdin_mode = "--stdin" in argv

    if stdin_mode:
        text = sys.stdin.read()
        out, why = transform(text, mode)
        if out is None:
            log("stdin noop: %s" % why)
            return 0
        sys.stdout.write(out)
        return 0

    lock = "/tmp/text-conv.lock"
    try:
        fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        os.write(fd, str(os.getpid()).encode())
        os.close(fd)
    except FileExistsError:
        log("busy, skip")
        return 0
    try:
        return do_convert(mode)
    finally:
        try:
            os.unlink(lock)
        except OSError:
            pass


def do_convert(mode):
    t0 = time.time()
    marks = []

    def mark(name):
        marks.append("%s=%.0f" % (name, (time.time() - t0) * 1000))

    klass = active_window()
    terminal = any(h in klass for h in TERMINAL_HINTS)
    log("mode=%s class=%r terminal=%s" % (mode, klass, terminal))
    mark("win")

    original = read_clip() or b""
    baseline = original  # с чем сравниваем буфер, чтобы понять «скопировалось»

    pasted = None
    how = "?"

    def grab(timeout_steps=15):
        """Ждём, пока буфер перестанет быть прежним: значит приложение скопировало.

        Раньше сюда писали метку `__TEXT_CONV_<pid>__` и ждали подтверждения
        владения — это стоило лишний `wl-copy` (~75 мс, пока буфером владеет
        чужое окно) и порождало гонку с записью. Сравнение с содержимым до
        нажатия дешевле: если копирование не удалось, буфер не изменится.
        """
        for _ in range(timeout_steps):
            time.sleep(0.008)
            got = read_clip()
            if DEBUG:
                dbg("poll: %r" % (got[:40] if got else got,))
            if got is not None and got != baseline:
                return got
        return None

    # 0. В браузерах и Electron сначала PRIMARY-выделение: инъекция не нужна,
    #    значит и Ctrl+Shift+C с открытием DevTools случиться не может.
    browser = any(hint in klass for hint in BROWSER_HINTS)
    if browser:
        prim = read_primary()
        if prim:
            pasted = prim
            how = "primary"
            mark("prim")

    # 1. копируем. Модификаторы хоткея отпускаются тем же вызовом wtype, но
    #    физический Shift этим не снимается: пока он зажат, Ctrl+C уходит как
    #    Ctrl+Shift+C (в Chrome это «inspect element»). Поэтому в браузерах
    #    сначала ждём, чтобы Shift отпустили, и только потом жмём.
    if pasted is None:
        if browser:
            time.sleep(BROWSER_MOD_DELAY)
        send_chord("c", terminal=terminal, release_mods=True)
        mark("copy")
        pasted = grab()
        mark("grab")
        if pasted is not None:
            how = "clip"

    # 1b) вторая попытка: аккорд мог не дойти (фокус, порядок событий)
    if pasted is None:
        dbg("retry copy")
        time.sleep(0.05)
        send_chord("c", terminal=terminal, release_mods=True)
        pasted = grab()
        mark("retry")
        if pasted is not None:
            how = "clip2"

    # 2) выделение мышью: Electron/Chromium отдаёт его в PRIMARY, а Ctrl+C иногда
    #    не срабатывает, поэтому читаем первичное выделение напрямую
    if pasted is None:
        prim = read_primary()
        if prim:
            dbg("primary: %r" % (prim[:60],))
            pasted = prim
            how = "primary"
        mark("prim")

    # 3) ничего не выделено — берём слово слева от курсора
    if pasted is None and not terminal:
        dbg("no selection, selecting word to the left")
        select_word_left()
        time.sleep(0.05)
        send_chord("c", terminal=terminal)
        pasted = grab()
        mark("word")
        if pasted is not None:
            how = "word"

    if pasted is None:
        log("no selection (clipboard unchanged) | %s" % " ".join(marks))
        notify("Ничего не выделено")
        return 0

    try:
        text = pasted.decode("utf-8")
    except UnicodeDecodeError:
        write_clip(original)
        notify("В буфере не текст")
        return 0

    out, why = transform(text, mode)
    if out is None:
        write_clip(original)
        log("noop: %s | text=%r | %s" % (why, text[:60], " ".join(marks)))
        notify(why)
        return 0

    if not set_clip(out, timeout=0.5):
        dbg("rewrite clipboard")  # соседний wl-copy мог перехватить владение
        if not set_clip(out):
            notify("Не удалось записать буфер обмена")
            return 0
    mark("sent2")
    send_chord("v", terminal=terminal)
    mark("paste")

    # раскладку системы ставим на тот язык, в который сконвертировали
    if mode == "layout":
        switch_keyboard_layout(why)
        mark("layout")

    log(
        "ok %s: %r -> %r | %.0f ms via=%s | %s"
        % (why, text[:60], out[:60], (time.time() - t0) * 1000, how, " ".join(marks))
    )

    # возвращаем прежний буфер чуть позже, чтобы вставка успела прочитать.
    # Только если в буфере всё ещё наш результат: иначе затрём то, что
    # пользователь скопировал сам, или буфер следующего запуска (гонка
    # восстановления с быстрым повторным нажатием давала «клип не подтверждён»)
    pid = os.getpid()
    old_file = "/tmp/text-conv-restore-%d.old" % pid
    new_file = "/tmp/text-conv-restore-%d.new" % pid
    cur_file = "/tmp/text-conv-restore-%d.cur" % pid
    with open(old_file, "wb") as f:
        f.write(original)
    with open(new_file, "wb") as f:
        f.write(out.encode("utf-8"))
    subprocess.Popen(
        [
            "sh",
            "-c",
            'sleep 1.5; wl-paste -n > "$3"; cmp -s "$3" "$2" && wl-copy < "$1";'
            ' rm -f "$1" "$2" "$3"',
            "sh",
            old_file,
            new_file,
            cur_file,
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
